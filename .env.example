# Local development. Production values are set in the deployment files.
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
API_ORIGIN=http://127.0.0.1:4000
PASSING_PUBLIC_ORIGIN=http://127.0.0.1:3000
PASSING_TRUST_PROXY=none
PASSING_STORAGE_BYTES=10000000000
PASSING_DISK_HEADROOM_BYTES=512000000
PASSING_REPORTS_PER_HOUR=3
PASSING_GLOBAL_REPORT_ATTEMPTS_PER_MINUTE=100
PASSING_GLOBAL_REPORTS_PER_HOUR=100
# Use 64 lowercase hex characters from 32 random bytes to enable /admin.
PASSING_ADMIN_KEY=

# Optional public settings for the web process
# PASSING_FEEDBACK_EMAIL=feedback@example.com
# PASSING_BITCOIN_DONATION_ADDRESS=
