{
  "name": "passing-cloud",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "next build",
    "start:web": "next start --hostname 0.0.0.0",
    "start:api": "tsx server/index.ts",
    "reports": "node --env-file-if-exists=.env --import tsx server/reports.ts",
    "monitor:transfer": "node --import tsx scripts/monitor-transfer.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "ipaddr.js": "^2.2.0",
    "libsodium-wrappers": "0.7.16",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.0",
    "uqr": "0.1.3",
    "zod": "^4.1.0"
  },
  "overrides": {
    "minimatch@^10.0.0": "11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.1.0",
    "jsqr": "1.4.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
